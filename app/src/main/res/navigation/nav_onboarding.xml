<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav"
    app:startDestination="@id/loginFragment2">
    <fragment
        android:id="@+id/loginFragment2"
        android:name="com.example.axoguia.onboarding.signIn.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_loginFragment2_to_registerFragment2"
            app:destination="@id/registerFragment2" />
        <action
            android:id="@+id/action_loginFragment2_to_restPasswordFragment"
            app:destination="@id/restPasswordFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment2"
        android:name="com.example.axoguia.onboarding.signup.RegisterFragment"
        android:label="fragment_register"
        tools:layout="@layout/fragment_register" >
        <action
            android:id="@+id/action_registerFragment2_to_registerPersonalFragment"
            app:destination="@id/registerPersonalFragment" />
    </fragment>
    <fragment
        android:id="@+id/restPasswordFragment"
        android:name="com.example.axoguia.onboarding.restpwd.RestPasswordFragment"
        android:label="RestPasswordFragment"
        tools:layout="@layout/fragment_rest_password" />
    <fragment
        android:id="@+id/registerPersonalFragment"
        android:name="com.example.axoguia.onboarding.registpersonal.RegisterPersonalFragment"
        android:label="fragment_register_personal"
        tools:layout="@layout/fragment_register_personal" />
</navigation>