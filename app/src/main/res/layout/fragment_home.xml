<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FA"
    android:fillViewport="true"
    tools:context=".home.main.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:fontFamily="casual"
            android:text="Axoguia"
            android:textColor="#1B4332"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="casual"
            android:text="Una guia para conocer, cuidar y ubicar espacios dedicados al ajolote."
            android:textAlignment="center"
            android:textColor="#344E41"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp"
            app:strokeColor="#B7E4C7"
            app:strokeWidth="1dp">

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="373dp"
            android:layout_height="252dp"
            android:orientation="vertical"
            android:padding="18dp">

            <ImageView
                android:layout_width="338dp"
                android:layout_height="wrap_content"
                android:contentDescription="Icono de Axoguia"
                android:src="@drawable/image_axo" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
